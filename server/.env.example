# ── Copy this file to server/.env and fill in real values. ──
# server/.env is gitignored and must NEVER be committed.

# Required environment variables
DAILY_API_KEY=
DEEPGRAM_API_KEY=

# LLM provider: "google" (default), "openai", or "anthropic".
LLM_PROVIDER=anthropic

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=                         # Required for Claude LLM — paste your sk-ant-... key
ANTHROPIC_MODEL=claude-haiku-4-5           # low-latency voice default; claude-sonnet-5 for stronger reasoning

GOOGLE_API_KEY=                            # Required for Google LLM
GOOGLE_MODEL=gemini-3.5-flash             # or gemini-2.5-flash if 3.5 felt sluggish
CLASSIFIER_MODEL=gemini-3.1-flash-lite
GOOGLE_TEMPERATURE=1.0                     # Default Google temperature

# Optional environment variables (override defaults as needed)

# Sets the base URL for the Daily API.
DAILY_API_URL=https://api.daily.co/v1

# Specifies the preferred TTS provider.
# Note: If CARTESIA_API_KEY is provided, the bot will use the Cartesia TTS service regardless of this value.
TTS_PROVIDER=deepgram

# Defines the voice identifier for Deepgram TTS (used if Cartesia is not active).
DEEPGRAM_VOICE=aura-athena-en

# CARTESIA_API_KEY is optional. Provide it only if you want to use Cartesia TTS.
# If omitted or left empty, the bot will default to Deepgram TTS.
CARTESIA_API_KEY=

# Specifies the voice identifier for Cartesia TTS.
CARTESIA_VOICE=79a125e8-cd45-4c13-8a67-188112f4dd22

# Configuration for the OpenAI language model.
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# Select the bot variant: "simple" or "flow".
BOT_TYPE=flow

# Enable the STT mute filter.
ENABLE_STT_MUTE_FILTER=false

# Per-call frame trace (debugging). When true, FrameTraceObserver writes a JSONL
# trace of every frame push to server/traces/ (gitignored). Convert it to a Perfetto
# timeline with: python tools/trace_to_perfetto.py traces/<file>.jsonl
TRACE_CALLS=false

# Include raw audio frames in the trace (very high frequency, ~50/sec). Only useful
# when debugging audio plumbing; leave off for a readable per-call timeline.
TRACE_AUDIO=false
# Whisker frame debugger. When true, runs a WhiskerServer WebSocket on WHISKER_PORT that
# the Whisker UI (https://whisker.pipecat.ai or a local clone) connects to for live frame
# inspection. Works with FreeSWITCH calls (it is a transport-independent observer).
WHISKER=false
WHISKER_PORT=9090

# FreeSWITCH ESL (control plane) — end-of-call hangup (uuid_kill) + dtmf_bridge.
ESL_HANGUP=true
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
HANGUP_DELAY_MS=1000
