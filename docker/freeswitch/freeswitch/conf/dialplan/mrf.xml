<include>
  <!--
    Pipecat demo dialplan (context "mrf" — where the pipecat SIP profile lands calls).

    5000 -> the AI bot. Uses drachtio's mod_audio_fork (MIT, no concurrency cap).
    The module attaches a media bug, streams the caller's audio (binary L16 @ 8 kHz)
    to the Pipecat bot over a WebSocket, and plays the bot's TTS back into the call
    from the `playAudio` JSON frames the bot sends (no STREAM_PLAYBACK channel var
    needed — that was mod_audio_stream's gate).

       uuid_audio_fork <uuid> start ws://bothost:7860/audio mono 8k
         mix-type = mono (caller only) ; sampling-rate = 8k

    Barge-in: the bot sends {"type":"killAudio"} on interruption to flush playback.

    7000 -> answer + park (no fork). Test extension for automated loopback checks:
       originate {origination_uuid=X}loopback/7000/mrf &park()

    Reload after edits:  docker exec pcfs-freeswitch fs_cli -x reloadxml
  -->
  <context name="mrf">
    <extension name="pipecat-bot">
      <condition field="destination_number" expression="^5000$">
        <action application="answer"/>
        <!-- NOTE: no send_silence_when_idle here. On parked sofia channels it fed the
             media bug ragged write-frames and chopped playback (loopback calls without
             it played pristine audio). -->
        <action application="set" data="stream=${uuid_audio_fork(${uuid} start ws://bothost:7860/audio mono 8k)}"/>
        <action application="park"/>
      </condition>
    </extension>
    <extension name="parked-test-leg">
      <condition field="destination_number" expression="^7000$">
        <action application="answer"/>
        <action application="park"/>
      </condition>
    </extension>
  </context>
</include>
